{
  "name": "guitar-audio-correction",
  "version": "1.0.0",
  "description": "CLI tool for correcting pitch and buzz in guitar recordings",
  "main": "cli.js",
  "bin": {
    "guitar-correct": "./cli.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev:server": "node server.js",
    "dev:ui": "cd ui && npm run dev",
    "build:ui": "cd ui && npm run build",
    "test": "node --test tests/test_cli.js",
    "test:server": "node --test tests/test_server.js",
    "test:python": "python -m pytest tests/test_audio_processor.py -v",
    "test:python:fast": "python -m pytest tests/test_audio_processor.py -v -m \"not slow\"",
    "test:all": "node --test tests/test_cli.js tests/test_server.js && npm run test:python",
    "check-deps": "node cli.js check-deps"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^2.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "guitar",
    "audio",
    "pitch-correction",
    "music-transcription"
  ],
  "license": "MIT"
}
